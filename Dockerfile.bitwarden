FROM node:22-bookworm-slim

ARG BITWARDEN_CLI_VERSION=2026.7.0
RUN npm install --global "@bitwarden/cli@${BITWARDEN_CLI_VERSION}" \
    && npm cache clean --force \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin bitwarden \
    && install --directory --owner bitwarden --group bitwarden /data

COPY --chmod=755 scripts/bitwarden-entrypoint.sh /usr/local/bin/bitwarden-entrypoint

ENV BITWARDENCLI_APPDATA_DIR=/data \
    BW_NOINTERACTION=true \
    BW_CLEANEXIT=true

USER bitwarden
EXPOSE 8087
ENTRYPOINT ["bitwarden-entrypoint"]
