CONNECT_ROSTACK_TOKEN=provisioned-connect-token
MAIL_ROSTACK_TOKEN=provisioned-mail-token
CONNECT_DISCOVERY_URL=http://connect-service.connect.svc.cluster.local:8080/.well-known/rostack
MAIL_DISCOVERY_URL=http://mailui.mail.svc.cluster.local:3000/.well-known/rostack
PORT=3000
POLL_INTERVAL_MS=15000
OTP_MAX_AGE_MS=86400000
INACTIVITY_TIMEOUT_MS=300000
BITWARDEN_API_URL=http://bitwarden-cli:8087
# Optional bearer token when an authenticated reverse proxy protects bw serve.
BITWARDEN_API_TOKEN=
BW_CLIENTID=user.your-client-id
BW_CLIENTSECRET=your-client-secret
# Optional for self-hosted or regional Bitwarden deployments.
BW_SERVER=https://vault.bitwarden.com
# Optional self-signed CA configuration.
BITWARDEN_CA_CERT_PEM=
